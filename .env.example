# URL produksi dipakai untuk metadata SEO, sitemap, dan JSON-LD.
NEXT_PUBLIC_SITE_URL=https://karyaalamjogja.com

# Sumber data katalog dan CMS. KA_SUPABASE_* diutamakan supaya deployment
# tidak tertimpa variabel yang dikelola integrasi marketplace Vercel.
KA_SUPABASE_URL=https://your-project.supabase.co
KA_SUPABASE_ANON_KEY=your-supabase-anon-key
KA_SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Panel admin (/admin). Ganti sebelum dipakai di server.
ADMIN_PASSWORD=ganti-dengan-sandi-kuat
# Kunci penandatangan sesi; string acak panjang (minimal 32 karakter).
ADMIN_SESSION_SECRET=ganti-dengan-string-acak-panjang

# Set 1 untuk otomatis commit perubahan konten ke git.
CMS_GIT_COMMIT=0
